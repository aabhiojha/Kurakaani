# Copy to `.env` and adjust. All values have working local defaults in docker-compose.yml,
# so `docker compose up` works out of the box without a .env file.

# --- Spring profile ---
# `dev` (default) has sensible local defaults. Use `prod` to require all secrets explicitly.
SPRING_PROFILES_ACTIVE=dev

# --- Database (Postgres) ---
DB_NAME=chat-app-db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Object storage (RustFS / S3-compatible) ---
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_BUCKET=kurakaani
STORAGE_REGION=rustfs

# --- Auth / CORS ---
JWT_SECRET=VGhpc0lzQVN1ZmZpY2llbnRseUxvbmdTZWNyZXRLZXlGb3JIUzI1Ng==
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Mail (required by the `prod` profile; leave blank for `dev`) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Frontend (build-time, inlined into the bundle) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_GLOBAL_ROOM_ID=1
